   "source": [
    "# Show the parent cluster first, then its post-hoc split subclusters\n",
    "\n",
    "display(Markdown(f\"### Parent Cluster for {dataset_name}\"))\n",
    "display(parent_summary)\n",
    "show_molecule_grid(\n",
    "    df_smiles,\n",
    "    parent_sorted_ids,\n",
    "    title=f\"Parent cluster {parent_cluster_index} before splitting ({dataset_name})\",\n",
    ")\n",
    "\n",
    "for sub_idx, subcluster in enumerate(subclusters[:max_subclusters_to_show], start=1):\n",
    "    display(Markdown(f\"### Subcluster {sub_idx}\"))\n",
    "    sub_summary = pd.DataFrame({\n",
    "        \"mol_id\": subcluster[\"mol_ids\"],\n",
    "        \"property_nM\": subcluster[\"props\"],\n",
    "    })\n",
    "    display(sub_summary)\n",
    "    show_molecule_grid(\n",
    "        df_smiles,\n",
    "        subcluster[\"mol_ids\"],\n",
    "        title=(\n",
    "            f\"Subcluster {sub_idx} | size={len(subcluster['mol_ids'])} | \"\n",
    "            f\"range={subcluster['prop_range']:.2f} nM | {dataset_name}\"\n",
    "        ),\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c2693438",
   "metadata": {},
   "source": [
    "## 8. Split Schematic\n",
    "\n",
    "This is a compact visual summary of the parent cluster branching into post-hoc smooth subclusters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "7394408b",
   "metadata": {
    "tags": []
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Simple schematic of the split\n",
    "import matplotlib.pyplot as plt\n",
    "fig, ax = plt.subplots(figsize=(14, 4))\n",
    "ax.set_axis_off()\n",
    "\n",
    "parent_box = dict(boxstyle=\"round,pad=0.4\", fc=\"#d9e8fb\", ec=\"#2a5d9f\", lw=2)\n",
    "sub_box = dict(boxstyle=\"round,pad=0.4\", fc=\"#e8f5e9\", ec=\"#2f7d32\", lw=2)\n",
    "\n",
    "ax.text(\n",
    "    0.15,\n",
    "    0.62,\n",
    "    f\"Parent cluster\\nsize = {len(parent_mol_ids)}\\nproperty span = {parent_sorted_props[-1] - parent_sorted_props[0]:.2f} nM\",\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "    fontsize=13,\n",
    "    bbox=parent_box,\n",
    ")\n",
    "\n",
    "subcluster_y = 0.18\n",
    "x_positions = np.linspace(0.42, 0.90, max(len(subclusters), 1))\n",
    "for idx, (x_pos, subcluster) in enumerate(zip(x_positions, subclusters), start=1):\n",
    "    ax.text(\n",
    "        x_pos,\n",
    "        subcluster_y,\n",
    "        f\"Subcluster {idx}\\nsize = {len(subcluster['mol_ids'])}\\nspan = {subcluster['prop_range']:.2f} nM\",\n",
    "        ha=\"center\",\n",
    "        va=\"center\",\n",
    "        fontsize=12,\n",
    "        bbox=sub_box,\n",
    "    )\n",
    "    ax.annotate(\n",
    "        \"\",\n",
    "        xy=(x_pos, subcluster_y + 0.18),\n",
    "        xytext=(0.22, 0.54),\n",
    "        arrowprops=dict(arrowstyle=\"->\", lw=1.8, color=\"#555555\"),\n",
    "    )\n",
    "\n",
    "ax.text(0.15, 0.05, f\"Post-hoc property span threshold = {property_span:.2f} nM\", ha=\"center\", fontsize=11)\n",
    "plt.tight_layout()\n",
    "fig.savefig(_safe_filename(\"split_schematic\", \"png\"), dpi=300)\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4bdef79f",
