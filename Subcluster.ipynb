   "source": [
    "from rdkit.Chem import rdFMCS\n",
    "\n",
    "\n",
    "def _mols_from_ids(df, mol_ids, smiles_col=\"smiles\", prop_col=\"exp_mean [nM]\"):\n",
    "    records = []\n",
    "    for mol_id in mol_ids:\n",
    "        smi = df.iloc[mol_id][smiles_col]\n",
    "        prop = float(df.iloc[mol_id][prop_col])\n",
    "        mol = Chem.MolFromSmiles(smi)\n",
    "        if mol is not None:\n",
    "            records.append({\"mol_id\": int(mol_id), \"mol\": mol, \"property_nM\": prop})\n",
    "    return records\n",
    "\n",
    "\n",
    "def _mcs_pattern(mols, timeout=15):\n",
    "    if len(mols) < 2:\n",
    "        return None, \"\", 0\n",
    "    mcs_result = rdFMCS.FindMCS(\n",
    "        mols,\n",
    "        timeout=timeout,\n",
    "        ringMatchesRingOnly=True,\n",
    "        completeRingsOnly=True,\n",
    "    )\n",
    "    smarts = mcs_result.smartsString\n",
    "    pattern = Chem.MolFromSmarts(smarts) if smarts else None\n",
    "    return pattern, smarts, int(mcs_result.numAtoms)\n",
    "\n",
    "\n",
    "def _sort_by_mcs_match(records, pattern):\n",
    "    ranked = []\n",
    "    for rec in records:\n",
    "        if pattern is None:\n",
    "            match_atoms = 0\n",
    "            match_fraction = 0.0\n",
    "        else:\n",
    "            matched_atoms = rec[\"mol\"].GetSubstructMatch(pattern)\n",
    "            match_atoms = len(matched_atoms)\n",
    "            match_fraction = match_atoms / max(rec[\"mol\"].GetNumAtoms(), 1)\n",
    "\n",
    "        ranked.append(\n",
    "            {\n",
    "                **rec,\n",
    "                \"mcs_match_atoms\": int(match_atoms),\n",
    "                \"mcs_match_fraction\": float(match_fraction),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    # Strongest MCS matches first from left to right.\n",
    "    ranked.sort(key=lambda x: (x[\"mcs_match_atoms\"], x[\"mcs_match_fraction\"]), reverse=True)\n",
    "    return ranked\n",
    "\n",
    "\n",
    "# Parent cluster sorted by parent-level MCS match score\n",
    "parent_records = _mols_from_ids(df_smiles, parent_sorted_ids)\n",
    "parent_mcs_pattern, parent_mcs_smarts, parent_mcs_atoms = _mcs_pattern([r[\"mol\"] for r in parent_records])\n",
    "parent_ranked = _sort_by_mcs_match(parent_records, parent_mcs_pattern)\n",
    "parent_mcs_sorted_ids = [r[\"mol_id\"] for r in parent_ranked]\n",
    "\n",
    "parent_mcs_table = pd.DataFrame(parent_ranked)[[\"mol_id\", \"property_nM\", \"mcs_match_atoms\", \"mcs_match_fraction\"]]\n",
    "parent_mcs_table.insert(0, \"rank\", np.arange(1, len(parent_mcs_table) + 1))\n",
    "\n",
    "display(Markdown(\"### Parent Cluster Sorted by MCS Match\"))\n",
    "print(f\"Parent MCS atoms: {parent_mcs_atoms}\")\n",
    "print(f\"Parent MCS SMARTS: {parent_mcs_smarts}\")\n",
    "display(parent_mcs_table)\n",
    "show_molecule_grid(\n",
    "    df_smiles,\n",
    "    parent_mcs_sorted_ids,\n",
    "    title=f\"Parent cluster sorted by MCS match (left to right, decreasing) ({dataset_name})\",\n",
    "    highlight_pattern=parent_mcs_pattern,\n",
    "    mols_per_row=4,\n",
    ")\n",
    "\n",
    "\n",
    "# Subclusters sorted by their own MCS size and then by size\n",
    "subcluster_structural = []\n",
    "for idx, sub in enumerate(subclusters, start=1):\n",
    "    records = _mols_from_ids(df_smiles, sub[\"mol_ids\"])\n",
    "    patt, smarts, num_atoms = _mcs_pattern([r[\"mol\"] for r in records])\n",
    "    ranked = _sort_by_mcs_match(records, patt)\n",
    "\n",
    "    subcluster_structural.append(\n",
    "        {\n",
    "            \"original_idx\": idx,\n",
    "            \"size\": len(records),\n",
    "            \"mcs_atoms\": num_atoms,\n",
    "            \"mcs_smarts\": smarts,\n",
    "            \"pattern\": patt,\n",
    "            \"ranked\": ranked,\n",
    "        }\n",
    "    )\n",
    "\n",
    "subcluster_structural.sort(key=lambda x: (x[\"mcs_atoms\"], x[\"size\"]), reverse=True)\n",
    "\n",
    "display(Markdown(\"### Subclusters Sorted by Shared Substructure\"))\n",
    "for new_idx, sub_info in enumerate(subcluster_structural[:max_subclusters_to_show], start=1):\n",
    "    ranked = sub_info[\"ranked\"]\n",
    "    sorted_ids = [r[\"mol_id\"] for r in ranked]\n",
    "\n",
    "    sub_table = pd.DataFrame(ranked)[[\"mol_id\", \"property_nM\", \"mcs_match_atoms\", \"mcs_match_fraction\"]]\n",
    "    sub_table.insert(0, \"rank\", np.arange(1, len(sub_table) + 1))\n",
    "\n",
    "    display(\n",
    "        Markdown(\n",
    "            f\"#### Subcluster {new_idx} (original {sub_info['original_idx']}) | \"\n",
    "            f\"size={sub_info['size']} | mcs_atoms={sub_info['mcs_atoms']}\"\n",
    "        )\n",
    "    )\n",
    "    print(f\"MCS SMARTS: {sub_info['mcs_smarts']}\")\n",
    "    display(sub_table)\n",
    "    show_molecule_grid(\n",
    "        df_smiles,\n",
    "        sorted_ids,\n",
    "        title=(\n",
    "            f\"Subcluster {new_idx} sorted by MCS match \"\n",
    "            f\"(left to right, decreasing) | mcs_atoms={sub_info['mcs_atoms']} | {dataset_name}\"\n",
    "        ),\n",
    "        highlight_pattern=sub_info[\"pattern\"],\n",
    "        mols_per_row=3 #len(sorted_ids),\n",
    "    )"
   ]
  },
