   "source": [
    "# Subcluster Splitting Illustration\n",
    "\n",
    "This notebook shows an illustration of the post hoc smooth subclustering. \n",
    "Each cluster is first arranged in increasing order of properties and then split in such a way that the range of properties within each cluster is unity."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7873624b",
   "metadata": {},
   "source": [
    "## 1. Defining helper functions\n",
    "\n",
    "This section uses the BitBIRCH clustering output, defines the directories and helper functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dae491eb",
   "metadata": {
    "tags": []
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Figures will be saved to: /blue/rmirandaquintana/ak.surendran/BitBIRCH_AC/BitBIRCH_AC/figures\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import sys\n",
    "import math\n",
    "import pandas as pd\n",
    "import re\n",
    "import numpy as np\n",
    "from IPython.display import display, SVG, Markdown\n",
    "from rdkit import Chem\n",
    "from rdkit.Chem import Draw\n",
    "from rdkit.Chem.Draw import rdMolDraw2D\n",
    "\n",
    "# Make the repository script importable from this notebook.\n",
    "repo_root = os.path.abspath(os.path.join(os.getcwd(), \"blue\", \"ak.surendran\", \"BitBIRCH_AC\"))\n",
    "if not os.path.exists(repo_root):\n",
    "    repo_root = os.path.abspath(os.path.join(os.getcwd(), \"BitBIRCH_AC\"))\n",
    "script_dir = os.path.join(repo_root, \"scripts\")\n",
    "if script_dir not in sys.path:\n",
    "    sys.path.append(script_dir)\n",
    "\n",
    "from scripts.smooth_ac_simplified import FingerprintClusterAnalyzer\n",
    "\n",
    "# Output directory for all saved figures.\n",
    "OUTPUT_DIR = os.path.join(repo_root, \"figures\")\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "print(f\"Figures will be saved to: {OUTPUT_DIR}\")\n",
    "\n",
    "# ── Editable display settings ──────────────────────────────────────────────\n",
    "MOL_IMG_SIZE     = (420, 420)  # per-molecule canvas (width, height) in pixels\n",
    "LEGEND_FONT_SIZE = 24          # legend font size in points — increase to make text larger\n",
    "# ───────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# Helper functions for molecule grid display\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "def _safe_filename(title, ext):\n",
    "    \"\"\"Convert a title string into a safe filename.\"\"\"\n",
    "    name = re.sub(r\"[^\\w\\-]+\", \"_\", title).strip(\"_\")\n",
    "    return os.path.join(OUTPUT_DIR, f\"{name}.{ext}\")\n",
    "\n",
    "\n",
    "def _index_to_letters(index):\n",
    "    \"\"\"Convert a zero-based index to a lowercase letter label: a, b, ..., z, aa, ab, ...\"\"\"\n",
    "    index += 1\n",
    "    letters = []\n",
    "    while index > 0:\n",
    "        index, remainder = divmod(index - 1, 26)\n",
    "        letters.append(chr(ord(\"a\") + remainder))\n",
    "    return \"\".join(reversed(letters))\n",
    "\n",
    "\n",
    "def show_molecule_grid(\n",
    "    df_smiles,\n",
    "    mol_ids,\n",
    "    smiles_col=\"smiles\",\n",
    "    prop_col=\"exp_mean [nM]\",\n",
    "    title=\"\",\n",
    "    highlight_pattern=None,\n",
    "    mols_per_row=4,\n",
    "):\n",
    "    \"\"\"Render molecules with letter-plus-property legends and optional substructure highlighting.\n",
    "\n",
    "    Uses rdMolDraw2D directly so LEGEND_FONT_SIZE is applied precisely.\n",
    "    The SVG is also saved to OUTPUT_DIR.\n",
    "    \"\"\"\n",
    "    molecules = []\n",
    "    legends = []\n",
    "    highlight_atom_lists = []\n",
    "    rows = df_smiles.iloc[mol_ids]\n",
    "\n",
    "    for idx, (mol_id, (_, row)) in enumerate(zip(mol_ids, rows.iterrows())):\n",
    "        mol = Chem.MolFromSmiles(row[smiles_col])\n",
    "        if mol is None:\n",
    "            continue\n",
    "        molecules.append(mol)\n",
    "        legends.append(f\"{_index_to_letters(idx)}: {row[prop_col]:.2f} nM\")\n",
    "        if highlight_pattern is not None:\n",
    "            matched = mol.GetSubstructMatch(highlight_pattern)\n",
    "            highlight_atom_lists.append(list(matched) if matched else [])\n",
    "        else:\n",
    "            highlight_atom_lists.append([])\n",
    "\n",
    "    if not molecules:\n",
    "        print(f\"No valid molecules to show for {title}\")\n",
    "        return\n",
    "\n",
    "    ncols = max(1, int(mols_per_row))\n",
    "    nrows = math.ceil(len(molecules) / ncols)\n",
    "    mol_w, mol_h = MOL_IMG_SIZE\n",
    "    canvas_w = ncols * mol_w\n",
    "    canvas_h = nrows * mol_h\n",
    "\n",
    "    drawer = rdMolDraw2D.MolDraw2DSVG(canvas_w, canvas_h, mol_w, mol_h)\n",
    "    opts = drawer.drawOptions()\n",
    "    opts.legendFontSize = LEGEND_FONT_SIZE\n",
    "\n",
    "    drawer.DrawMolecules(\n",
    "        molecules,\n",
    "        legends=legends,\n",
    "        highlightAtoms=highlight_atom_lists,\n",
    "    )\n",
    "    drawer.FinishDrawing()\n",
    "    svg_str = drawer.GetDrawingText()\n",
    "\n",
    "    # Save SVG to disk.\n",
    "    svg_path = _safe_filename(title, \"svg\")\n",
    "    with open(svg_path, \"w\") as f:\n",
    "        f.write(svg_str)\n",
    "    print(f\"Saved: {svg_path}\")\n",
    "\n",
    "    display(Markdown(f\"### {title}\"))\n",
    "    display(SVG(svg_str))\n",
    "\n",
    "\n",
    "def greedy_property_split(mol_ids, props, property_span=1.0):\n",
    "    \"\"\"Split sorted molecule IDs into subclusters with max span <= property_span.\"\"\"\n",
    "    order = np.argsort(props)\n",
    "    sorted_ids = np.asarray(mol_ids)[order]\n",
    "    sorted_props = np.asarray(props)[order]\n",
    "\n",
    "    subclusters = []\n",
    "    left = 0\n",
    "    while left < len(sorted_ids):\n",
    "        right = left\n",
    "        while right + 1 < len(sorted_ids) and (sorted_props[right + 1] - sorted_props[left] <= property_span):\n",
    "            right += 1\n",
    "        subclusters.append({\n",
    "            \"mol_ids\": sorted_ids[left:right + 1].tolist(),\n",
    "            \"props\": sorted_props[left:right + 1].tolist(),\n",
    "            \"prop_min\": float(sorted_props[left]),\n",
    "            \"prop_max\": float(sorted_props[right]),\n",
    "            \"prop_range\": float(sorted_props[right] - sorted_props[left]),\n",
    "            \"prop_std\": float(np.std(sorted_props[left:right + 1])),\n",
    "        })\n",
    "        left = right + 1\n",
    "\n",
    "    return sorted_ids.tolist(), sorted_props.tolist(), subclusters\n"
   ]
  },
