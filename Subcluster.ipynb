    "import re\n",
    "\n",
    "# Configuration for the real post-hoc smooth example\n",
    "# This notebook is set up for CHEMBL234_Ki specifically.\n",
    "dataset_name = \"CHEMBL234_Ki\"\n",
    "fp_type = \"MACCS\"\n",
    "threshold = 0.9\n",
    "property_span = 1.0\n",
    "max_subclusters_to_show = 5\n",
    "\n",
    "# Adjust these paths if your workspace layout changes.\n",
    "data_dir = \"files_copy\"\n",
    "smiles_file = f\"data/{dataset_name}.csv\"\n",
    "data_prefix = f\"{dataset_name}_fp\"\n",
    "prop_prefix = f\"{dataset_name}_fp\"\n",
    "\n",
    "# Load the BitBIRCH analyzer and compute exhaustive post-hoc smooth clusters.\n",
    "analyzer = FingerprintClusterAnalyzer(fingerprint_types=[fp_type], thresholds=[threshold], top=20)\n",
    "analyzer.load_fingerprint_data(\n",
    "    data_prefix=data_prefix,\n",
    "    prop_prefix=prop_prefix,\n",
    "    data_dir=data_dir,\n",
    ")\n",
    "analyzer.perform_exhaustive_posthoc_smooth_clustering(\n",
    "    property_span=property_span,\n",
    "    top_subclusters=20,\n",
    ")\n",
    "\n",
    "key = f\"{fp_type}_{threshold}\"\n",
    "cluster_info = analyzer.cluster_data[key]\n",
    "cliff_ids = cluster_info[\"cliff_ids\"]\n",
    "props = cluster_info[\"properties\"]\n",
    "df_smiles = pd.read_csv(smiles_file)\n",
    "\n",
    "# Choose the first parent cluster that contains at most 8 molecules.\n",
    "# TODO: Remove the hard-coded limit of 8 and make it a parameter.\n",
    "max_parent_cluster_size = 8\n",
    "parent_cluster_index = next((i for i, cluster in enumerate(cliff_ids) if len(cluster) <= max_parent_cluster_size), 0)\n",
    "parent_mol_ids = np.asarray(cliff_ids[parent_cluster_index])\n",
    "parent_props = props[parent_mol_ids]\n",
    "\n",
    "# Split the parent cluster into post-hoc smooth subclusters.\n",
    "parent_sorted_ids, parent_sorted_props, subclusters = greedy_property_split(\n",
    "    parent_mol_ids,\n",
    "    parent_props,\n",
    "    property_span=property_span,\n",
    ")\n",
    "\n",
    "print(f\"Dataset: {dataset_name}\")\n",
    "print(f\"Selected parent cluster index: {parent_cluster_index}\")\n",
    "print(f\"Parent cluster size: {len(parent_mol_ids)}\")\n",
    "print(f\"Number of post-hoc subclusters: {len(subclusters)}\")\n",
    "\n",
    "# Build a compact table for the original parent cluster.\n",
    "parent_summary = pd.DataFrame({\n",
    "    \"mol_id\": parent_sorted_ids,\n",
    "    \"property_nM\": parent_sorted_props,\n",
    "})\n",
    "\n",
    "# Build a table for each split subcluster so the next cell can render them cleanly.\n",
    "subcluster_summaries = []\n",
    "for idx, subcluster in enumerate(subclusters, start=1):\n",
    "    subcluster_summaries.append(\n",
    "        pd.DataFrame({\n",
    "            \"subcluster\": idx,\n",
    "            \"mol_id\": subcluster[\"mol_ids\"],\n",
    "            \"property_nM\": subcluster[\"props\"],\n",
    "        })\n",
    "    )\n",
    "\n",
    "parent_summary"
   ]
  },
